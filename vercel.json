{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://seikai.dev/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "dashai.dev" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://seikai.dev/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "www.dashai.dev" }]
    },
    {
      "source": "/(.*)",
      "destination": "https://portfolio.seikai.dev/$1",
      "permanent": true,
      "has": [{ "type": "host", "value": "portfolio.dashai.dev" }]
    }
  ]
}
